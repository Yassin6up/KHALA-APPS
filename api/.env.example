# ─────────────────────────────────────────────────────────────────────────────
# KHALA API — environment template
#
# Copy to `api/.env` and fill in real values. `.env` is gitignored; never commit
# real secrets, and never paste a secret key anywhere it could be logged.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/khala"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# ── Stripe ───────────────────────────────────────────────────────────────────
# SERVER ONLY. Anyone holding this can charge cards, refund, and read customer
# data. It must never reach a mobile bundle or the admin front-end.
STRIPE_SECRET_KEY=sk_live_xxx

# Safe to expose. Sent to the apps so the PaymentSheet can be initialised.
STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# From `stripe listen` (dev) or the endpoint's signing secret in the dashboard.
# REQUIRED: without it every webhook is rejected, which means paid subscriptions
# are never activated and bookings are never marked paid.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# The account's registration country decides which currencies it can charge.
STRIPE_ACCOUNT_COUNTRY=US
# Charges fall back to this when an item's own currency is not chargeable.
STRIPE_SETTLEMENT_CURRENCY=usd

# ── Billing ──────────────────────────────────────────────────────────────────
# Leave unset in production. When "true", POST /billing/subscribe activates a
# paid plan with no payment — dev and comp accounts only.
# ALLOW_MANUAL_SUBSCRIPTIONS=false

# ── Email ────────────────────────────────────────────────────────────────────
# Without these, MailService logs emails to the console instead of sending them
# — fine for local dev, but booking/session emails silently never reach anyone
# in production until this is set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace-me
SMTP_FROM="KHALA <noreply@khala.app>"

# Where "user deleted their account" notices are sent (public deletion page).
# Falls back to ADMIN_EMAIL, then privacy@khalaapps.com.
DELETION_NOTICE_EMAIL=privacy@khalaapps.com

# ── Coach portal ─────────────────────────────────────────────────────────────
# Public URL of the admin/coach-portal Next.js app (no trailing slash). Used to
# link a coach straight to "add your meeting link" in the new-booking email.
# Leave unset in dev — the email just drops the button and keeps the plain-text
# instructions.
COACH_PORTAL_URL=https://admin.khalaapps.com
