# Copy to .env and set your laptop's local IP so physical devices can reach the API.
# Find your IP: ipconfig (Windows) | ifconfig (Mac/Linux) — look for 192.168.x.x
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/v1

# Stripe publishable key — safe to ship in the client bundle.
# The SECRET key (sk_...) belongs only in api/.env, never here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
