# ────────────────────────────────────────────────────────────────────────────────
# KHALA Platform — root .gitignore
# Covers: /api (NestJS), /app-qader (Expo), /admin (Next.js), /packages/shared
# ────────────────────────────────────────────────────────────────────────────────

# ── Dependencies ─────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ────────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
api/dist/
packages/shared/dist/

# ── Environment & secrets ────────────────────────────────────────────────────────
# Never commit real env files — keep only the .example templates
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

!.env.example
!**/.env.example

# ── Database ─────────────────────────────────────────────────────────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3
api/prisma/migrations/dev.db

# ── Expo / React Native ──────────────────────────────────────────────────────────
app-qader/.expo/
app-qader/.expo-shared/
app-qader/expo-env.d.ts

# Native build artefacts (generated by `expo prebuild` / EAS Build)
app-qader/android/
app-qader/ios/

# Signing & credentials
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ── Next.js / Admin ──────────────────────────────────────────────────────────────
admin/.next/
admin/out/

# ── Logs ────────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS & editor ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── TypeScript ───────────────────────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Cache ────────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache

# ── Testing & coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────────────────────────────────────
*.local
*.tgz
